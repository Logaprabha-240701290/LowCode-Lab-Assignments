 application "Admission Enquiry Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Counselling_Follow_up_Form
		{
			displayname = "Counselling Follow-up Form"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Leads
			(
				type = picklist	
				datasource = zoho_crm_leads
    			displayformat = [email]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Counselling_Date
			(
    			type = date
				displayname = "Counselling Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Outcome
			(
				type = picklist
				maxchar = 100
				values = {"Interested","Not Interested","Call Back"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Enquiry_Form
		{
			displayname = "Enquiry Form"
			success message = "Enquiry Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Student_Name
			(
    			type = name
				displayname = "Student Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Mobile_Number
			(
    			type = phonenumber
				displayname = "Mobile Number"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			City
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Program_Interested
			(
				type = picklist
				displayname = "Program Interested"
				maxchar = 100
				values = {"B.E. CSE","B.Tech AI&DS","B.E. ECE","B.E. Mech"}
				initial value = "B.Tech AI&DS"
	 			row = 1
	 			column = 1   
				width = medium
			)
			th_Percentage
			(
				type = decimal
				displayname = "12th Percentage"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Enquiry_Source
			(
				type = picklist
				displayname = "Enquiry Source"
				maxchar = 100
				values = {"Website","Walk-in","Education Fair","Referral"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Remarks
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list All_Enquiries
		{
			displayName = "All Enquiries"
			show all rows from Enquiry_Form    
			(
				Student_Name  as "Student Name"
				Email
				Mobile_Number as "Mobile Number"
				(
					displayformat = plainnumber 
				)
				City
				Program_Interested as "Program Interested"
				th_Percentage as "12th Percentage"
				Enquiry_Source as "Enquiry Source"
				Remarks
			)
		}
		default list Counselling_Follow_up_Form_Report
		{
			displayName = "Counselling Follow-up Form Report"
			show all rows from Counselling_Follow_up_Form    
			(
				Leads
				Counselling_Date as "Counselling Date"
				Outcome
			)
		}
	}




		workflow
		{
		form
		{
			Create_CRM_Lead_on_Enquir as "Create CRM Lead on Enquiry Submission"
			{
				type =  form
				form = Enquiry_Form

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											lead_data = Map();
										lead_data.put("First_Name",input.Student_Name.first_name);
										lead_data.put("Last_Name",input.Student_Name.last_name);
										lead_data.put("Email",input.Email);
										lead_data.put("Mobile",input.Mobile_Number);
										lead_data.put("City",input.City);
										lead_data.put("Program_Interested",input.Program_Interested);
										lead_data.put("Twelfth_Percentage",input.th_Percentage);
										lead_data.put("Lead_Source",input.Enquiry_Source);
										lead_data.put("Description",input.Remarks);
										lead_data.put("Company","REC Admissions 2026");
										lead_data.put("Lead_Status","Not Contacted");
										response = zoho.crm.createRecord("Leads",lead_data,Map(),"zoho_crm_connection");
										info response;
						)
					}
				}

			}
		}






	}
