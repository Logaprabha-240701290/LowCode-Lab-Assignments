				permissions = {Chat:false, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Developer Profile\n"
			}
			"Administrator"
			{
				name = "Administrator"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have all the permissions.\n"
			}
			"Customer"
			{
				name = "Customer"
				type = Customer_Portal
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This is the default profile having only add and view permission.\n"
			}
			roles
			{
				"CEO"
				{
					description = "User belonging to this role can access data of all other users."
				}
			}
	}

	customize
	{
		icon
		{
			text = "AEM"
			background color = "theme"
			foreground color = "#ffffff"
		}
	}

	connections
	{
		zoho_crm_connection
		(
			displayname = "Zoho CRM Connection"
			connector = zohocrm1
			permissions = {"search_quotes_record","sync_invoices_record","sync_deals_record","sync_contacts_record","sync_cases_record","sync_campaigns_record","sync_accounts_record","search_vendors_record","search_solutions_record","search_sales_orders_record","sync_leads_record","search_purchase_orders_record","search_products_record","search_leads_record","search_invoices_record","search_deals_record","search_contacts_record","search_cases_record","search_campaigns_record","search_accounts_record","update_contacts_record","update_vendors_record","update_solutions_record","update_sales_orders_record","update_quotes_record","update_purchase_orders_record","update_products_record","update_leads_record","update_invoices_record","update_deals_record","list_all","update_cases_record","update_campaigns_record","update_accounts_record","sync_vendors_record","sync_solutions_record","sync_sales_orders_record","sync_quotes_record","sync_purchase_orders_record","sync_products_record","create_sales_orders_record","fetch_all_invoices_records","fetch_all_deals_records","fetch_all_contacts_records","fetch_all_cases_records","fetch_all_campaigns_records","fetch_all_accounts_records","fetch_accounts_record","create_vendors_record","create_solutions_record","fetch_all_leads_records","create_quotes_record","create_purchase_orders_record","create_products_record","create_leads_record","create_invoices_record","create_deals_record","create_contacts_record","create_cases_record","create_campaigns_record","fetch_contacts_record","fetch_vendors_record","fetch_solutions_record","fetch_sales_orders_record","fetch_quotes_record","fetch_purchase_orders_record","fetch_products_record","fetch_leads_record","fetch_invoices_record","fetch_deals_record","create_accounts_record","fetch_cases_record","fetch_campaigns_record","fetch_all_vendors_records","fetch_all_solutions_records","fetch_all_sales_orders_records","fetch_all_quotes_records","fetch_all_purchase_orders_records","fetch_all_products_records"}
		)
