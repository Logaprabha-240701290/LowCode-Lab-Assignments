		workflow
		{
		form
		{
			Set_New_Lending_Request_t as "Set New Lending Request to Pending"
			{
				type =  form
				form = Lending_Request
				on add
				{
					actions  (Request_Status == "Pending")
					{
						show Request_Status;
					}
				}
			}
			Update_Book_Availability_ as "Update Book Availability on Approval"
			{
				type =  form
				form = Lending_Request
				on add or edit
				{
					actions 
					{
					on success
					(
						if(input.Request_Status == "Approved")
										{
											bookRecord = Book[ID == input.Book];
											if(bookRecord != null)
											{
												bookRecord.Availability_Status="Borrowed";
											}
										}
					)
					}
				}
			}
			Return_a_book_and_update_ as "Return a book and update its availability"
			{
				type =  form
				form = Return_form
				on add
				{
					actions 
					{
					on success
					(
						if(input.Book != null)
										{
											bookRecord = Book[ID == input.Book];
											if(bookRecord != null)
											{
												bookRecord.Availability_Status="Available";
											}
										}
					)
					}
				}
			}
			Email_when_a_lending_requ as "Email when a lending request is approved"
			{
				type =  form
				form = Lending_Request
				on edit
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : "zoho.loginuserid"
							subject : "Your book request has been approved"
							message : "<div>${zoho.loginuserid} has updated a record in form Lending Request<br></div><p><span>Hello,</span><br></p><p><span>Your book lending request has been approved!</span><br></p><p><span>Please check your lending request details in the Smart Book Lending and Exchange Platform.</span><br></p><p><br></p><div><span>Thank you,</span><br></div><div><span>Smart Book Lending and Exchange Platform Team</span><br></div><p><br></p><div><br></div>"
							content type : Plain Text
						)
					}
				}
			}
			Student_to_Zoho_CRM_Lead_ as "Student to Zoho CRM Lead Integration"
			{
				type =  form
				form = Student
				on add
				{
					actions 
					{
					on success
					(
						lead_data = Map();
										lead_data.put("Last_Name",input.Student_Name);
										lead_data.put("Company","Smart Book Lending Platform");
										lead_data.put("Email",input.Email);
										lead_data.put("Phone",input.Phone_Number1);
										response = zoho.crm.createRecord("Leads",lead_data,Map(),"zoho_crm_connection1");
										info response;
					)
					}
				}
			}
		}






	}
